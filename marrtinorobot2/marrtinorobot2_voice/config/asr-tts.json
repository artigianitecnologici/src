{
    "output_samplerate": 48000,
    "output_device_index": 0,
    "input_samplerate": 16000,
    "language": "it",
    "work_offline": true,
    "msg_start": "Ciao, sono operativo",
    "wake_words": [
        "martino",
        "peppino"
    ],
    "wake_match": "prefix",
    "wake_word_max_distance": 1,
    "question_timeout_sec": 8,
    "case_sensitive": false,
    "normalize_accents": true,
    "faster_whisper": {
        "model": "small",
        "device": "cpu",
        "compute_type": "int8",
        "download_dir": "/home/ubuntu/src/marrtinorobot2/marrtinorobot2_voice/models/faster-whisper",
        "beam_size": 3,
        "initial_prompt": "Marrtino, Eva.",
        "vad_threshold": 350,
        "vad_silence_sec": 0.65,
        "vad_min_speech_sec": 0.25,
        "vad_max_speech_sec": 15,
        "vad_preroll_sec": 0.25
    },
    "beep": {
        "enabled": true,
        "frequency": 1000,
        "duration_ms": 180,
        "volume": 0.2
    },
    "msg_ack": "",
    "tts_pre_audio_delay_ms": 200,
    "tts_anim_delay_ms": 0,
    "tts_special_gestures": {
        "enabled": true,
        "strip_emojis_from_tts": true,
        "max_events": 4,
        "rules": [
            {
                "token": "👋",
                "gesture": "hello",
                "delay_ms": 0
            },
            {
                "token": "😊",
                "gesture": "happy",
                "delay_ms": 120
            },
            {
                "token": "😜",
                "gesture": "playful",
                "delay_ms": 180
            },
            {
                "token": "🤔",
                "gesture": "thinking",
                "delay_ms": 220
            },
            {
                "token": "😮",
                "gesture": "surprised",
                "delay_ms": 140
            },
            {
                "token": "😅",
                "gesture": "shrug",
                "delay_ms": 260
            }
        ]
    },
    "tts_pre_delay_ms": 200,
    "chatbot": {
        "provider": "sonia",
        "endpoints": {
            "eva": "http://127.0.0.1:5000/json",
            "n8n": "http://127.0.0.1:5002/json",
            "sonia": "http://127.0.0.1:5003/json"
        },
        "connect_timeout": 3,
        "read_timeout": 135,
        "max_retries": 2
    },
    "piper_models_dir": "/home/ubuntu/src/marrtinorobot2/marrtinorobot2_voice/models/piper",
    "piper_default_voice": "serena-high",
    "piper_voices": {
        "it": "serena-high",
        "en": "lessac-medium"
    },
    "piper_length_scale": 1.3,
    "piper_noise_scale": 0.6,
    "piper_noise_w": 0.45,
    "piper_playback": {
        "device": "plughw:0,0",
        "normalize": true,
        "volume": 1,
        "pitch": 100,
        "tempo": 0.9,
        "treble": 3,
        "highpass": 120
    },
    "debug": false
}
